# Copy to .env and fill in only the providers you actually use.
# DataMind reads these at startup and pre-fills the API key box in the sidebar.
# You can also paste a key straight into the UI and skip this file entirely.

# Groq - https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Nvidia NIM - https://build.nvidia.com
NVIDIA_API_KEY=

# Anthropic Claude - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Ollama needs no key. Override the host only if it is not on the default port.
# OLLAMA_HOST=http://localhost:11434
